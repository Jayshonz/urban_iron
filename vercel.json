{
  "redirects": [
    { "source": "/admin", "destination": "https://admin.urbaniron.co/races", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/races", "destination": "/admin.html" },
    { "source": "/races/admin.js", "destination": "/public/admin.js" },
    { "source": "/races/styles.css", "destination": "/public/styles.css" },
    { "source": "/races/admin.css", "destination": "/public/admin.css" },
    { "source": "/races/favicon.png", "destination": "/favicon.png" },
    { "source": "/api/race-admin/:path*", "destination": "/api/:path*" },
    { "source": "/analytics.js", "destination": "/public/analytics.js" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/checkin.css", "destination": "/public/checkin.css" },
    { "source": "/urban-iron-checkin-logo.png", "destination": "/public/urban-iron-checkin-logo.png" },
    { "source": "/create-logo-orange.png", "destination": "/public/create-logo-orange.png" }
  ]
}
